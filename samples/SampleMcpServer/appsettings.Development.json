{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "McpExplorer": {
    "Servers": {
      "example-backend": {
        "Title": "Example Backend API",
        "Endpoint": "http://localhost:5100/mcp",
        "Headers": {
          "Authorization": {
            "Required": true,
            "Secret": true,
            "Placeholder": "Bearer <token>",
            "Description": "ExampleBackendApi accepts any value starting with 'Bearer '."
          }
        }
      }
    }
  }
}
