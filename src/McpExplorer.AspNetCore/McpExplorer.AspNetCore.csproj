<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>McpExplorer</RootNamespace>

    <PackageId>McpExplorer.AspNetCore</PackageId>
    <Version>0.3.0</Version>
    <Description>Swagger/Scalar-style interactive UI for Model Context Protocol (MCP) servers in ASP.NET Core. Add one line (app.MapMcpExplorer()) to browse all MCP tools, fill schema-generated forms, send requests with custom headers (Authorization, tokens) and inspect responses.</Description>
    <PackageTags>mcp;model-context-protocol;swagger;scalar;ui;aspnetcore</PackageTags>
    <RepositoryUrl>https://github.com/devvolkankocak/McpExplorer.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/devvolkankocak/McpExplorer.AspNetCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>devvolkankocak</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="McpExplorer.wwwroot.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
